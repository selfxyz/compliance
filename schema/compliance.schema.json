{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/selfxyz/compliance/schema/compliance.schema.json",
  "title": "Self compliance config (.github/compliance.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "mode": {
      "enum": ["report", "block"],
      "default": "report",
      "description": "report (default): findings never block. block: a fail finding or a leaked secret fails the gate."
    },
    "kind": {
      "$ref": "#/$defs/kinds",
      "description": "Shortcut for a single-workspace repo: the whole repo is this kind. Use either kind or workspaces."
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workspace"
      }
    },
    "ignore": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Path globs left out of every check (fixtures, generated code). Listed in the job summary."
    },
    "exceptions": {
      "type": "array",
      "description": "Repo-level licence exceptions. Same fields as exceptions.yml in selfxyz/compliance. Listed in the job summary.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "package": {
            "type": "string",
            "description": "Package name or file path, glob."
          },
          "licence": {
            "type": "string",
            "description": "Optional regex on the licence string."
          },
          "rule": {
            "type": "string",
            "description": "Optional policy rule id (gpl, lgpl, fonts, licence_file, ...)."
          },
          "reason": {
            "type": "string",
            "minLength": 20
          },
          "expires": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "branch_rules": {
      "type": "object",
      "additionalProperties": false,
      "description": "Branch protection this repo must have. Default: the default branch needs a pull request with 1 approval and no force push.",
      "properties": {
        "protected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Branches to check. Default: the default branch."
        },
        "approvals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Approvals a pull request needs. Default 1. 0 needs a reason."
        },
        "reason": {
          "type": "string",
          "minLength": 20
        }
      },
      "if": {
        "required": ["approvals"],
        "properties": {
          "approvals": {
            "const": 0
          }
        }
      },
      "then": {
        "required": ["reason"]
      }
    }
  },
  "oneOf": [
    {
      "required": ["kind"],
      "not": {
        "required": ["workspaces"]
      }
    },
    {
      "required": ["workspaces"],
      "not": {
        "required": ["kind"]
      }
    }
  ],
  "$defs": {
    "kind": {
      "enum": ["ios-app", "android-app", "native-sdk", "rn-module", "npm-package", "web-app", "docs", "service", "contracts", "circuits", "infra", "tooling", "example", "test-app"]
    },
    "kinds": {
      "oneOf": [
        {
          "$ref": "#/$defs/kind"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kind"
          }
        }
      ]
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {
        "path": {
          "type": "string",
          "description": "Folder relative to the repo root; \".\" for the root."
        },
        "kind": {
          "$ref": "#/$defs/kinds"
        },
        "override": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "reason"],
          "properties": {
            "profile": {
              "enum": ["distributed", "web", "contracts", "backend", "excluded"]
            },
            "reason": {
              "type": "string",
              "minLength": 20
            }
          },
          "description": "Use different rules than the kind implies, or leave the folder out (excluded). Skips the cross-check. Listed in the job summary."
        }
      }
    }
  }
}
